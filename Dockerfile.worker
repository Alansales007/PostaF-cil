# Processo worker (BullMQ) — consome a fila de publicação. Precisa ser um
# processo de longa duração (nunca uma função serverless): faz polling de
# status nas APIs sociais e não pode viver dentro do ciclo de vida de uma
# requisição HTTP. Roda via tsx (sem etapa de compilação própria).

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate

USER nextjs
CMD ["npx", "tsx", "workers/index.ts"]
