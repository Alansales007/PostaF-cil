# ============================================================
# PostaFácil — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA cometa o arquivo .env de verdade no repositório.
# ============================================================

# --- App -----------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Chave usada pelo NextAuth para assinar sessões/JWT (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Banco de dados (PostgreSQL / Supabase) -------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postafacil?schema=public

# --- Redis (fila BullMQ) --------------------------------------
REDIS_URL=redis://localhost:6379

# --- Criptografia de tokens OAuth em repouso ------------------
# 32 bytes em hex (64 caracteres). Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Armazenamento de mídia (S3-compatible: AWS S3, Cloudflare R2 ou Supabase Storage) ---
# STORAGE_PROVIDER=local grava em disco (./.data/uploads) — só para desenvolvimento,
# sem precisar de nenhum bucket real. Use "s3" em produção (ou sempre que quiser
# testar o fluxo real de upload direto para a nuvem).
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=postafacil-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true

# --- Upload de vídeo -------------------------------------------
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-m4v,video/3gpp

# --- Retenção de mídia temporária -----------------------------
MEDIA_RETENTION_HOURS=24

# --- Modo mock (desenvolvimento sem credenciais reais) --------
# Quando true, todos os providers sociais respondem com dados simulados.
MOCK_SOCIAL_APIS=true

# --- Instagram (API with Instagram Login / "Business Login for Instagram") ---
# Criar em https://developers.facebook.com — produto "Instagram" do app,
# usando o App ID / App Secret específicos do Instagram (não o do Facebook).
# Confirme sempre a versão mais recente da Graph API no painel do app antes
# de ir para produção — v21.0 aqui é só um valor de partida conservador.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/social/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v21.0

# --- Facebook (Facebook Login for Business — usado a partir da ETAPA 4) ---
# Criar em https://developers.facebook.com — produto "Facebook Login for Business"
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/social/facebook/callback
META_GRAPH_API_VERSION=v21.0

# --- TikTok -----------------------------------------------------
# Criar em https://developers.tiktok.com — produtos:
# "Login Kit" + "Content Posting API"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/social/tiktok/callback

# --- Kwai ------------------------------------------------------
# Acesso mediante aprovação prévia da Kwai (Open Platform).
# Enquanto não houver credenciais aprovadas, a UI mostra
# "Integração aguardando autorização da plataforma."
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
KWAI_REDIRECT_URI=http://localhost:3000/api/social/kwai/callback
KWAI_API_AVAILABLE=false

# --- Rate limiting ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
